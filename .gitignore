!SteeLog/SteeLog/packages/EPPlus.dll
!SteeLog/SteeLog/packages/itextsharp.dll
!SteeLog/SteeLog/Guna.UI2.dll

# Clave ClickOnce local: no distribuir en el repositorio.
SteeLog/SteeLog/SteeLog_TemporaryKey.pfx

# Archivos de salida temporales
out.json
error.log

# ==============================================================================
# Archivos específicos del proyecto
