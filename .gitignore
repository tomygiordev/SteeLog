*.pdb
*.exe
*.dll
*.cache
*.resources
*.log
*.tmp
*.temp

# Paquetes de NuGet
packages/
*.nupkg
*.snupkg

# Dependencias locales versionadas: los HintPath requieren estos paquetes y DLL.
!SteeLog/packages/
SteeLog/packages/*
!SteeLog/packages/Guna.UI2.WinForms.2.0.4.7/
!SteeLog/packages/Guna.UI2.WinForms.2.0.4.7/**
!SteeLog/packages/Npgsql.5.0.18/
!SteeLog/packages/Npgsql.5.0.18/**
!SteeLog/packages/System.Threading.Channels.4.7.0/
!SteeLog/packages/System.Threading.Channels.4.7.0/**
!SteeLog/packages/System.ValueTuple.4.5.0/
!SteeLog/packages/System.ValueTuple.4.5.0/**
!SteeLog/SteeLog/packages/
SteeLog/SteeLog/packages/*
